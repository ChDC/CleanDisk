# The token that writes the releases of the apps to the Gitee repository
# of the builds (`lanshanshu/release`). It is a personal access token
# of Gitee with the right `projects` (read and write).
#
# The release script reads GITEE_TOKEN from the environment first and
# falls back to this file, so a release can be made without typing the
# token again:
#
#   scripts/release-gitee.sh
#
# **This file is in a private repository and has to stay in one.** The
# token can write to the repository the app takes its updates from, and
# the app installs what it finds there — a token that leaks is a way to
# put an APK of someone else's making on the phones of the users.
GITEE_TOKEN=988bed2c0c1ff69e8dfaba051e9e8f75
